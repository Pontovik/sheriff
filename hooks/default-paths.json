{
  "ignore": [
    "*.md", "*.mdx", "*.markdown", "*.rst", "*.adoc",
    "*.png", "*.jpg", "*.jpeg", "*.gif", "*.bmp", "*.ico", "*.webp", "*.svg", "*.psd",
    "*.pdf", "*.doc", "*.docx", "*.xls", "*.xlsx", "*.ppt", "*.pptx", "*.odt",
    "*.mp3", "*.wav", "*.ogg", "*.mp4", "*.mov", "*.avi", "*.webm",
    "*.ttf", "*.otf", "*.woff", "*.woff2", "*.eot",
    "/LICENSE", "/LICENSE.txt", "/COPYING", "/CHANGELOG", "/CHANGELOG.txt", "/AUTHORS", "/NOTICE",
    ".env", ".env.*", "*.pem", "*.key", "*.pfx", "*.p12", "*.jks", "*.keystore",
    "id_rsa*", "id_ecdsa*", "id_ed25519*", ".npmrc", ".pypirc", ".netrc"
  ],
  "excludeDirs": [
    ".git", "node_modules", "bin", "obj", "dist", "build", "target",
    ".venv", "venv", "__pycache__", ".idea", ".vs"
  ]
}
